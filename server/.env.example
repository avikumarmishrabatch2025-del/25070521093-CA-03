PORT=5000
# MongoDB Atlas example: mongodb+srv://DB_USER:DB_PASSWORD@cluster-name.xxxxx.mongodb.net/finpilot?retryWrites=true&w=majority
# Local MongoDB example: mongodb://127.0.0.1:27017/finpilot
MONGODB_URI=mongodb://127.0.0.1:27017/finpilot
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173
# Optional AI provider. Leave blank to use local rule-based insights.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
MONGODB_TIMEOUT_MS=15000
